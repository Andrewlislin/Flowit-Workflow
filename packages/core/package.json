{
  "name": "@coaseedgeltd/flowit-core",
  "version": "0.5.0-beta.3",
  "description": "Host-agnostic durable orchestration core for Flowit Workflow.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/core/index.js",
  "types": "dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./bridge/*": {
      "types": "./dist/bridge/*.d.ts",
      "default": "./dist/bridge/*.js"
    },
    "./internal/file-lock": {
      "types": "./dist/internal/file-lock.d.ts",
      "default": "./dist/internal/file-lock.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andrewlislin/Flowit-Workflow.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
